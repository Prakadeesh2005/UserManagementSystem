 <Window x:Class="User_Management.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Management"
        Height="650" Width="1050"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#FCE4EC">

    <Window.Resources>
        <!-- TEXTBOX STYLE -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#F1C6D5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,5,0,12"/>
        </Style>

        <!-- COMBOBOX STYLE -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#F1C6D5"/>
            <Setter Property="Margin" Value="0,7,0,8"/>
        </Style>

        <!-- BUTTON STYLE -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#E91E63"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- TABLE HEADER STYLE -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#F8BBD0"/>
            <Setter Property="Foreground" Value="#54283B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>

        <!-- TABLE ROW STYLE -->
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F8BBD0"/>
                    <Setter Property="Foreground" Value="#54283B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="325"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT REGISTRATION PANEL -->

        <Border Grid.Row="0" Grid.Column="0"
                Background="#FFFFFF"
                Padding="26">

            <StackPanel>
                <TextBlock Text="Select user" FontSize="11" Foreground="#555555"/>
                <ComboBox Name="cmbnames" SelectionChanged="cmbnames_SelectionChanged"/>
                <TextBlock Text="Choose a registered user to load their details below" FontSize="10" Foreground="#777777" TextWrapping="Wrap" Margin="0,0,0,15"/>
                <Separator Background="#F1C6D5" Margin="0,0,0,18"/>
                <TextBlock Text="User details" FontSize="19" FontWeight="Bold" Foreground="#333333"/>
                <TextBlock Text="Fill in the form and click Register" FontSize="11" Foreground="#777777" Margin="0,5,0,18"/>
                <TextBlock Text="Name" FontSize="11"/>
                <TextBox Name="txtname"/>
                <TextBlock Text="Phone" FontSize="11"/>
                <TextBox Name="txtPhone"/>
                <TextBlock Text="Email" FontSize="11"/>
                <TextBox Name="txtEmail"/>
                <TextBlock Text="Location" FontSize="11"/>
                <TextBox Name="txtLocation"/>
                <Button Name="btnreg" Content="＋  Register" Click="btnreg_Click" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- RIGHT REGISTERED USERS PANEL -->
        <Grid Grid.Row="0" Grid.Column="1" Background="#FCE4EC">

            <Grid.RowDefinitions>
                <RowDefinition Height="85"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,15,24,5">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Registered users" FontSize="21" FontWeight="Bold" Foreground="#333333"/>
                    <TextBlock Text="Every new registration appears here and in the Select user list" FontSize="11" Foreground="#777777"  Margin="0,5,0,0"/>
                </StackPanel>
                <Border Background="#F8BBD0" CornerRadius="15" Padding="12,5" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Name="txtUserCount" Text="0 users" FontSize="11" Foreground="#54283B"/>
                </Border>
            </Grid>

            <!-- WHITE USER TABLE CARD -->
            <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="10" Margin="24,0,24,22" BorderBrush="#F1C6D5" BorderThickness="1">
                <ListView Name="listuser" BorderThickness="0" Background="Transparent" Margin="5" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="NAME" Width="190" DisplayMemberBinding="{Binding name}"/>
                            <GridViewColumn Header="PHONE" Width="130" DisplayMemberBinding="{Binding phone}"/>
                            <GridViewColumn Header="EMAIL" Width="190" DisplayMemberBinding="{Binding email}"/>
                            <GridViewColumn Header="LOCATION" Width="130" DisplayMemberBinding="{Binding locations}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#FFFFFF" BorderBrush="#F1C6D5" BorderThickness="0,1,0,0">
            <TextBlock Name="txtStatus" Text="Ready"  FontSize="10" Foreground="#27844B" VerticalAlignment="Center" Margin="15,0"/>
        </Border>
    </Grid>
</Window>
